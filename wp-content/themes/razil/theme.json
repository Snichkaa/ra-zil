{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "ink",
					"name": "Графит",
					"color": "var(--rz-ink)"
				},
				{
					"slug": "ink-soft",
					"name": "Графит светлый",
					"color": "var(--rz-ink-soft)"
				},
				{
					"slug": "action",
					"name": "Действие",
					"color": "var(--rz-action)"
				},
				{
					"slug": "fact",
					"name": "Факт",
					"color": "var(--rz-fact)"
				},
				{
					"slug": "bg",
					"name": "Фон",
					"color": "var(--rz-bg)"
				},
				{
					"slug": "surface",
					"name": "Карточка",
					"color": "var(--rz-surface)"
				},
				{
					"slug": "line",
					"name": "Граница",
					"color": "var(--rz-line)"
				}
			]
		},
		"typography": {
			"defaultFontFamilies": false,
			"defaultFontSizes": false,
			"customFontSize": false,
			"fluid": false,
			"fontStyle": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "pt-serif",
					"name": "PT Serif",
					"fontFamily": "\"PT Serif\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "PT Serif",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/pt-serif-400.woff2" ]
						}
					]
				},
				{
					"slug": "pt-sans",
					"name": "PT Sans",
					"fontFamily": "\"PT Sans\", system-ui, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "PT Sans",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/pt-sans-400.woff2" ]
						},
						{
							"fontFamily": "PT Sans",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/pt-sans-700.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "label",
					"name": "Метка 14",
					"size": "0.875rem"
				},
				{
					"slug": "caption",
					"name": "Подпись 16",
					"size": "1rem"
				},
				{
					"slug": "body",
					"name": "Текст 18",
					"size": "1.125rem"
				},
				{
					"slug": "lead",
					"name": "Лид 20",
					"size": "1.25rem"
				},
				{
					"slug": "heading-s",
					"name": "H3 21-24",
					"size": "clamp(1.3125rem, 1.2348rem + 0.331vw, 1.5rem)"
				},
				{
					"slug": "heading-m",
					"name": "H2 26-34",
					"size": "clamp(1.625rem, 1.4178rem + 0.884vw, 2.125rem)"
				},
				{
					"slug": "heading-l",
					"name": "H1 32-48",
					"size": "clamp(2rem, 1.5856rem + 1.768vw, 3rem)"
				}
			]
		},
		"spacing": {
			"units": [ "rem" ],
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "4",
					"size": "0.25rem"
				},
				{
					"slug": "20",
					"name": "8",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "12",
					"size": "0.75rem"
				},
				{
					"slug": "40",
					"name": "16",
					"size": "1rem"
				},
				{
					"slug": "50",
					"name": "24",
					"size": "1.5rem"
				},
				{
					"slug": "60",
					"name": "32",
					"size": "2rem"
				},
				{
					"slug": "70",
					"name": "48",
					"size": "3rem"
				},
				{
					"slug": "80",
					"name": "64",
					"size": "4rem"
				},
				{
					"slug": "90",
					"name": "96",
					"size": "6rem"
				}
			]
		},
		"border": {
			"radius": false,
			"color": false,
			"style": false,
			"width": false
		},
		"shadow": {
			"presets": [],
			"defaultPresets": false
		},
		"dimensions": {
			"aspectRatio": false
		},
		"layout": {
			"contentSize": "72.5rem",
			"wideSize": "72.5rem"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--pt-sans)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--pt-serif)",
					"fontSize": "var(--wp--preset--font-size--heading-l)",
					"fontWeight": "400",
					"lineHeight": "1.15"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--pt-serif)",
					"fontSize": "var(--wp--preset--font-size--heading-m)",
					"fontWeight": "400",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--pt-serif)",
					"fontSize": "var(--wp--preset--font-size--heading-s)",
					"fontWeight": "400",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--pt-serif)",
					"fontSize": "var(--wp--preset--font-size--heading-s)",
					"fontWeight": "400",
					"lineHeight": "1.3"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--action)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--fact)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":visited": {
					"color": {
						"text": "var(--wp--preset--color--action)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--fact)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--action)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": {
					"radius": "4px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--pt-sans)",
					"fontSize": "var(--wp--preset--font-size--body)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				},
				"padding": {
					"top": "0",
					"right": "1.5rem",
					"bottom": "0",
					"left": "1.5rem"
				},
				":hover": {
					"color": {
						"background": "var(--rz-action-hover)",
						"text": "var(--wp--preset--color--surface)"
					}
				},
				":active": {
					"color": {
						"background": "var(--rz-action-active)",
						"text": "var(--wp--preset--color--surface)"
					}
				},
				":visited": {
					"color": {
						"text": "var(--wp--preset--color--surface)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--fact)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--caption)",
					"lineHeight": "1.5"
				},
				"color": {
					"text": "var(--wp--preset--color--ink-soft)"
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "4px"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				}
			},
			"core/heading": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				}
			},
			"core/paragraph": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				},
				"typography": {
					"lineHeight": "1.65"
				}
			},
			"core/list": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				},
				"typography": {
					"lineHeight": "1.65"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--line)"
				},
				"border": {
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--line)"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--body)"
				},
				"border": {
					"color": "var(--wp--preset--color--line)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Шапка",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Подвал",
			"area": "footer"
		},
		{
			"name": "sticky-call",
			"title": "Липкая полоса со звонком",
			"area": "footer"
		}
	]
}