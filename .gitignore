# WordPress core
/wp-admin/
/wp-includes/
/index.php
/wp-*.php
/xmlrpc.php
/license.txt
/readme.html
/.htaccess

# wp-content
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/
/wp-content/languages/
/wp-content/index.php
/wp-content/*.php

/wp-content/plugins/*
!/wp-content/plugins/razil-core/

/wp-content/themes/*
!/wp-content/themes/razil/

# Theme build
# build/ намеренно НЕ игнорируется: functions.php регистрирует блоки
# из build/blocks/*, сборки на сервере нет, и без этого каталога
# свежий клон остаётся без всех блоков темы.
/wp-content/themes/razil/node_modules/
/wp-content/themes/razil/debug-blocks.php

# Local artifacts
debug.log
*.log
*.sql
*.sql.gz
.env
.env.*

# Docs and prompts
PROMPT-*.md
*REPORT.md
CHECK_RESULTS.txt
inventory.txt
*.dc.html

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Скачанная копия старого сайта на Битриксе: 693 файла, 93 МБ.
# Контент с неё перенесён в базу, сама копия удалена с диска.
# Из истории git она не ушла — это потребовало бы перезаписи, — но
# новые коммиты её больше не тащат. При надобности старый сайт
# смотрится через веб-архив.
/_import/old-bitrix/

# Video: в git ему не место при любом размере.
# _import/media/ целиком не игнорируем: там 16 нужных исходников
# от 3 КБ до 265 КБ и один лишний видеофайл.
*.mp4
*.mov
*.m4v
*.avi
*.mkv
*.webm

# Зависимости в любом каталоге, не только в теме
node_modules/

# Доступы к базе. Уже покрыт правилом /wp-*.php выше, но для файла
# с паролями полагаться на маску не стоит.
/wp-config.php

# Временные и служебные
*.bak
*.bak[0-9]
*.orig
*.rej
*.tmp
*~
error_log

# Артефакты проверок
rz-tmp-*
/_check/

# Сборка для переноса: дампы базы, архивы, wp-config с паролями и солями.
# В git не попадает ничего из этого — там пароли доступа к серверу.
/_deploy/

# Резервные копии содержимого записей перед правками в базе.
# Это слепки локальной базы, а не исходный код: в гите они быстро
# устареют и только мешают читать историю правок.
/_backup/

# Папка-источник импорта целиком. Прежде игнорировался только
# old-bitrix, а media/ держали в гите ради исходников картинок.
# Исходники уже загружены в медиатеку, и копия в репозитории
# второго источника правды не стоит. Ранее закоммиченные файлы
# правило не трогает: gitignore действует только на неотслеживаемые.
/_import/

# Отчёты и дампы страниц от служебных скриптов в _scripts/.
# Сами скрипты остаются под версионным контролем.
_scripts/*.html
_scripts/*.txt
