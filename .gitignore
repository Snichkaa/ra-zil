# WordPress core
/wp-admin/
/wp-includes/
/index.php
/wp-*.php
/xmlrpc.php
/license.txt
/readme.html
/.htaccess

# wp-content
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/
/wp-content/languages/
/wp-content/index.php
/wp-content/*.php

/wp-content/plugins/*
!/wp-content/plugins/razil-core/

/wp-content/themes/*
!/wp-content/themes/razil/

# Theme build
# build/ намеренно НЕ игнорируется: functions.php регистрирует блоки
# из build/blocks/*, сборки на сервере нет, и без этого каталога
# свежий клон остаётся без всех блоков темы.
/wp-content/themes/razil/node_modules/
/wp-content/themes/razil/debug-blocks.php

# Local artifacts
debug.log
*.log
*.sql
*.sql.gz
.env
.env.*

# Docs and prompts
PROMPT-*.md
*REPORT.md
CHECK_RESULTS.txt
inventory.txt
*.dc.html

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/settings.local.json

# Video: в git ему не место при любом размере.
# Медиа и виртуальный тур переносятся отдельно вместе с uploads.
*.mp4
*.mov
*.m4v
*.avi
*.mkv
*.webm

# Зависимости в любом каталоге, не только в теме
node_modules/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Доступы к базе. Уже покрыт правилом /wp-*.php выше, но для файла
# с паролями полагаться на маску не стоит.
/wp-config.php

# Временные и служебные
*.bak
*.bak[0-9]
*.orig
*.rej
*.tmp
*~
error_log
~$*

# Артефакты проверок
rz-tmp-*
/_check/
/_audit/
/_reports/shots/
/_reports/text-*.txt

# Рабочие Excel-таблицы сохраняются локально. Карта страниц в JSON,
# её генератор и текстовые отчёты остаются в репозитории.
/_reports/*.xlsx

# Сборка для переноса: дампы базы, архивы, wp-config с паролями и солями.
# В git не попадает ничего из этого — там пароли доступа к серверу.
/_deploy/

# Резервные копии содержимого записей перед правками в базе.
# Это слепки локальной базы, а не исходный код: в гите они быстро
# устареют и только мешают читать историю правок.
/_backup/

# Локальные исходники импорта. Используемые фотографии уже в uploads,
# содержимое страниц хранится в базе WordPress.
/_import/

# Скрипты и промежуточные данные завершённых этапов разработки.
# Они остаются на диске для справки; повторно применять их к текущей
# базе без проверки нельзя. Общие инструменты _tools/redesign остаются в Git.
/_tools/t[0-9]*/
/_tools/redesign/*-content/
/_tools/redesign/cremation-2026-10.*
/_tools/redesign/services-2026-10.php
/_tools/redesign/pages-tour-2026-10.py
/_tools/redesign/prepare-*.mjs
/_tools/redesign/build-14.py
/_tools/redesign/restyle-service.php
/_tools/redesign/main-order.txt

# Отчёты и дампы страниц от служебных скриптов в _scripts/.
# Сами скрипты остаются под версионным контролем.
_scripts/*.html
_scripts/*.txt
