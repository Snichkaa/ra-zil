# WordPress core
/wp-admin/
/wp-includes/
/index.php
/wp-*.php
/xmlrpc.php
/license.txt
/readme.html
/.htaccess

# wp-content
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/
/wp-content/languages/
/wp-content/index.php
/wp-content/*.php

/wp-content/plugins/*
!/wp-content/plugins/razil-core/

/wp-content/themes/*
!/wp-content/themes/razil/

# Theme build
# build/ намеренно НЕ игнорируется: functions.php регистрирует блоки
# из build/blocks/*, сборки на сервере нет, и без этого каталога
# свежий клон остаётся без всех блоков темы.
/wp-content/themes/razil/node_modules/
/wp-content/themes/razil/debug-blocks.php

# Local artifacts
debug.log
*.log
*.sql
*.sql.gz
.env
.env.*

# Docs and prompts
PROMPT-*.md
*REPORT.md
CHECK_RESULTS.txt
inventory.txt
*.dc.html

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Скачанная копия старого сайта на Битриксе: 693 файла, 93 МБ.
# Контент с неё перенесён в базу, сама копия удалена с диска.
# Из истории git она не ушла — это потребовало бы перезаписи, — но
# новые коммиты её больше не тащат. При надобности старый сайт
# смотрится через веб-архив.
/_import/old-bitrix/

# Video: в git ему не место при любом размере.
# _import/media/ целиком не игнорируем: там 16 нужных исходников
# от 3 КБ до 265 КБ и один лишний видеофайл.
*.mp4
*.mov
*.m4v
*.avi
*.mkv
*.webm

# Зависимости в любом каталоге, не только в теме
node_modules/

# Доступы к базе. Уже покрыт правилом /wp-*.php выше, но для файла
# с паролями полагаться на маску не стоит.
/wp-config.php

# Временные и служебные
*.bak
*.orig
*.rej
*.tmp
*~
error_log

# Артефакты проверок
rz-tmp-*
/_check/
